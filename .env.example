APP_NAME="Mélanie Photographie"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mails : MAIL_FROM_ADDRESS est l'adresse du site. Elle expédie, figure dans les pages légales et reçoit
# les demandes du formulaire (OVH les redirige vers la boîte personnelle). En production, SMTP d'OVH (MX Plan) :
# MAIL_MAILER=smtp, MAIL_HOST=smtp.mail.ovh.net, MAIL_PORT=587, MAIL_SCHEME=smtp, identifiants de la boîte.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@melanie-photographie.fr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Site : téléphone (sert aussi pour WhatsApp ; vide : valeur de config/site.php).
# En production : APP_URL=https://www.melanie-photographie.fr
SITE_TELEPHONE=

# Fiche Google (Google Business Profile) : identifiant de lieu (Place ID) ; vide : valeur de config/site.php.
GOOGLE_PLACE_ID=

# Avis de la fiche Google (Business Profile API, php artisan avis:actualiser) : client OAuth du projet
# Google Cloud et jeton d'actualisation du compte propriétaire de la fiche. Vides : pas d'avis sur le site.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=

# hCaptcha (formulaire de contact) : clés du compte sur dashboard.hcaptcha.com. Vides : pas de vérification.
# Clés de test, toujours acceptées : 10000000-ffff-ffff-ffff-000000000001 / 0x0000000000000000000000000000000000000000
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
